---
import Button from './Button.astro';
import { PHONE_DISPLAY, PHONE_HREF } from '../consts';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = "Let's build your team's capability.",
  body = 'Tell us about your team and your goals, and we will put together a training plan built around them.',
} = Astro.props;
---

<section class="py-24 md:py-32 bg-sage">
  <div class="max-w-7xl mx-auto px-6 md:px-8 text-center">
    <h2 class="font-serif font-medium text-3xl md:text-4xl text-ink tracking-tight mb-6">
      {heading}
    </h2>
    <p class="text-base md:text-lg text-char leading-relaxed max-w-xl mx-auto mb-10">
      {body}
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <Button href={PHONE_HREF} variant="primary">Call {PHONE_DISPLAY}</Button>
      <Button href="/contact" variant="secondary">Send a message</Button>
    </div>
  </div>
</section>
