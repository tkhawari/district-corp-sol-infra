---
import { PHONE_DISPLAY, PHONE_HREF, EMAIL } from '../consts';
import { sectors } from '../data';

const services = [
  'Capacity building',
  'Corporate training workshops',
  'Leadership and team building',
  'Soft skills training',
  'Business process optimisation',
  'HR and organisational consulting',
  'Strategic planning support',
];



const linkClass =
  'text-sm text-neutral-400 hover:text-white transition-colors no-underline focus-visible:outline-2 focus-visible:outline-leaf focus-visible:outline-offset-2 rounded-sm';
---

<footer class="bg-ink text-bone">
  <div
    class="max-w-7xl mx-auto px-6 md:px-8 py-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12"
  >
    <!-- Brand block -->
    <div>
      <p class="font-serif font-medium text-lg mb-3">Distinct Corporate Solutions</p>
      <p class="text-sm text-neutral-400 leading-relaxed">
        Building capable teams. Strengthening leadership. Improving performance. Professional
        training and business consulting since 2018.
      </p>
    </div>

    <!-- Services -->
    <div>
      <p class="text-sm font-semibold mb-4">Services</p>
      <ul class="space-y-2">
        {
          services.map((service) => (
            <li>
              <a href="/services" class={linkClass}>
                {service}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Sectors -->
    <div>
      <p class="text-sm font-semibold mb-4">Sectors we serve</p>
      <ul class="space-y-2">
        {sectors.map((sector) => <li class="text-sm text-neutral-400">{sector}</li>)}
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <p class="text-sm font-semibold mb-4">Contact</p>
      <div class="space-y-2">
        <p>
          <a href={PHONE_HREF} class={linkClass}>{PHONE_DISPLAY}</a>
        </p>
        <p>
          <a href={`mailto:${EMAIL}`} class={linkClass}>{EMAIL.split('@')[0]}<wbr />@{EMAIL.split('@')[1]}</a>
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom strip -->
  <div class="border-t border-neutral-800">
    <div class="max-w-7xl mx-auto px-6 md:px-8 py-4">
      <p class="text-sm text-neutral-400">© 2026 Distinct Corporate Solutions</p>
    </div>
  </div>
</footer>
