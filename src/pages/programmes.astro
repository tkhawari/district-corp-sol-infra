---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { programmes, team } from '../data';

// Map each programme to the trainers whose "Leads" list covers it.
const leadKeywords: Record<string, string[]> = {
  'Business Communication': ['Communication'],
  Teamwork: ['Teamwork'],
  'Prioritisation and Time Management': ['Time Management'],
  'Workplace Professionalism and Ethics': ['Professionalism and Ethics', 'Ethics'],
  'Intermediate Microsoft Office and Outlook': ['Microsoft Office'],
  'Leading High-Performing Teams': ['Leading Teams'],
  'Practical AI Adoption in the Workplace': ['AI Adoption'],
  'Workplace SGBV Prevention': ['SGBV Prevention'],
  'Stress Management and Resilience': ['Stress Management'],
};

const catalogue = programmes.map((programme) => {
  const keywords = leadKeywords[programme.name] ?? [];
  const trainers = team
    .filter((member) => member.leads.split(', ').some((lead) => keywords.some((k) => lead.includes(k))))
    .map((member) => member.name);
  return { ...programme, trainers };
});
---

<Layout
  title="Training Programmes"
  description="Nine ready-to-run corporate training programmes: business communication, teamwork, time management, professionalism and ethics, Microsoft Office, team leadership, practical AI, SGBV prevention, and stress management."
>
  <!-- Hero -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <h1 class="font-serif font-medium text-4xl md:text-5xl text-ink tracking-tight mb-6 max-w-3xl">
        Training programmes
      </h1>
      <p class="text-base md:text-lg text-char leading-relaxed max-w-2xl mb-8">
        Nine programmes we can run at short notice. Each one is adjusted to your industry and to the
        people attending, and we can combine topics from different programmes if that suits you
        better.
      </p>
      <Button href="/contact" variant="primary">Ask about a programme</Button>
    </div>
  </section>

  <!-- Catalogue -->
  <section class="pb-20 md:pb-28">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <ul class="border-t border-line">
        {
          catalogue.map((programme) => (
            <li class="border-b border-line py-10 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12">
              <div class="lg:col-span-5">
                <h2 class="font-serif font-medium text-2xl text-ink mb-2">{programme.name}</h2>
                <p class="text-sm text-moss font-medium mb-4">{programme.audience}</p>
                <p class="text-base text-char leading-relaxed">{programme.note}</p>
              </div>
              <div class="lg:col-span-7">
                <h3 class="text-sm font-semibold text-ink mb-3">Topics</h3>
                <ul class="text-base text-char space-y-1.5 list-disc pl-5 marker:text-leaf mb-5">
                  {programme.topics.map((topic) => <li>{topic}</li>)}
                </ul>
                {programme.trainers.length > 0 && (
                  <p class="text-sm text-mute">
                    Trainers: {programme.trainers.join(', ')}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 text-base text-char max-w-2xl">
        Looking for something that isn't here? We also design organisational development modules
        around a specific need, such as preparing supervisors for a restructure.
      </p>
    </div>
  </section>

  <ClosingCTA
    heading="Not sure which programme fits?"
    body="Tell us who you want to train and what you'd like to change. We'll suggest a programme, or a mix of topics."
  />
</Layout>
