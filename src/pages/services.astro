---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { Image } from 'astro:assets';
import { PHONE_DISPLAY, PHONE_HREF } from '../consts';
import { services, sectors, gallery } from '../data';

const serviceImages = [gallery[1], gallery[2]];

const faqs = [
  {
    q: 'Can you change a programme to suit our staff?',
    a: "Yes, and we usually do. We swap in examples from your industry, adjust the level for the people attending, and drop or add topics. If none of the nine programmes fits, we can build a module from scratch.",
  },
  {
    q: 'Who are the programmes aimed at?',
    a: 'It depends on the programme. Some are for all staff and supervisors, most are for mid-level staff, and Leading High-Performing Teams is for first-line managers. The programmes page lists the audience for each one.',
  },
  {
    q: 'Which sectors have you worked in?',
    a: 'Banking, mining, pharmaceuticals, education and the development sector, plus universities, schools and community organisations.',
  },
  {
    q: 'Who actually delivers the training?',
    a: 'One of our 12 specialist trainers, matched to the subject. You can read about each of them on the team page, including how many sessions they have run and which programmes they lead.',
  },
  {
    q: 'Do you only do training?',
    a: 'No. Our Business Solutions work covers process improvement, HR and organisational consulting, strategic planning, and policy and compliance frameworks. Some clients use both, for example a new HR policy followed by training for the managers who will apply it.',
  },
  {
    q: 'How do we get started?',
    a: `Call ${PHONE_DISPLAY} or use the contact form. Tell us who you want to train and what you want to change, and we'll come back with a suggested plan.`,
  },
];
---

<Layout
  title="Services: Training and Business Consulting"
  description="Training and Development and Business Solutions from Distinct Corporate Solutions: capacity building, leadership programmes, soft skills, process improvement, HR consulting and strategic planning."
>

  <!-- Hero -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <h1 class="font-serif font-medium text-4xl md:text-5xl text-ink tracking-tight mb-6 max-w-3xl">
        Training for your people, and help with the systems they work in.
      </h1>
      <p class="text-base md:text-lg text-char leading-relaxed max-w-2xl mb-8">
        Training alone rarely fixes a problem caused by unclear processes or missing policies, so we
        offer both. You can use one or the other, or combine them.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/contact" variant="primary">Ask for a proposal</Button>
        <Button href={PHONE_HREF} variant="secondary">Call {PHONE_DISPLAY}</Button>
      </div>
    </div>
  </section>

  <!-- Services in detail -->
  <section class="pb-20 md:pb-28">
    <div class="max-w-7xl mx-auto px-6 md:px-8 space-y-20 md:space-y-28">
      {services.map((service, i) => (
        <article class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 items-center">
          <Image
            src={serviceImages[i].image}
            alt={serviceImages[i].alt}
            width={760}
            class:list={['w-full aspect-[4/3] object-cover rounded-sm', i % 2 === 1 && 'md:order-2']}
            loading="lazy"
          />
          <div>
            <h2 class="font-serif font-medium text-3xl text-ink mb-3">{service.name}</h2>
            <p class="font-medium text-lg text-ink mb-3">{service.tagline}</p>
            <p class="text-base text-char leading-relaxed mb-6">{service.body}</p>
            <h3 class="text-sm font-semibold text-ink mb-3">Includes</h3>
            <ul class="text-base text-char space-y-2 list-disc pl-5 marker:text-leaf">
              {service.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- How we work -->
  <section class="py-20 md:py-28 bg-paper">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h2 class="font-serif font-medium text-3xl md:text-4xl text-ink tracking-tight mb-6">
            How we usually work
          </h2>
          <div class="space-y-5 text-base md:text-lg text-char leading-relaxed">
            <p>
              We start by asking what you want to be different afterwards. Fewer complaints about
              email tone, managers who give feedback instead of avoiding it, staff who know where
              the line is on harassment. That answer decides the programme, the trainer and how
              long we spend on each topic.
            </p>
            <p>
              Sessions are interactive. Expect role-plays, case discussions and practice with real
              documents rather than a long slide deck. For Microsoft Office and AI adoption,
              participants work at a computer for most of the session.
            </p>
          </div>
        </div>
        <div>
          <h2 class="font-serif font-medium text-2xl text-ink mb-6">Sectors we've worked in</h2>
          <ul class="flex flex-wrap gap-2">
            {sectors.map((sector) => (
              <li class="border border-line px-4 py-2 rounded-full text-sm text-char bg-bone">{sector}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <h2 class="font-serif font-medium text-3xl md:text-4xl text-ink tracking-tight mb-10">
        Questions we get asked
      </h2>

      <div class="max-w-3xl">
        {faqs.map((faq) => (
          <details class="border-b border-line group">
            <summary class="cursor-pointer flex justify-between items-center py-6 font-serif text-lg text-ink list-none [&::-webkit-details-marker]:hidden">
              {faq.q}
              <span class="ml-4 flex-shrink-0 text-moss transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="pt-0 pb-6 text-base text-char leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ClosingCTA />

</Layout>
