---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { Image } from 'astro:assets';
import { SITE_DESCRIPTION } from '../consts';
import { services, programmes, clients, trainerExperience, gallery } from '../data';

const [heroPhoto, ...workPhotos] = gallery;
---

<Layout description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <section>
    <div class="w-full overflow-hidden">
      <Image
        src={heroPhoto.image}
        width={1600}
        height={900}
        alt={heroPhoto.alt}
        class="w-full aspect-[4/3] md:aspect-[21/9] object-cover object-[center_45%]"
        loading="eager"
      />
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-8 py-14 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end">
        <h1 class="lg:col-span-7 font-serif font-medium text-4xl md:text-5xl lg:text-6xl text-ink tracking-tight leading-[1.1]">
          Workplace training and consulting for organisations across Pakistan.
        </h1>
        <div class="lg:col-span-5">
          <p class="text-base md:text-lg text-char leading-relaxed mb-8">
            Since 2018 we've run training for banks, a mining company, universities, schools and
            development organisations. Our 12 trainers have delivered over 600 sessions between
            them, on communication, leadership, ethics, AI at work and more.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button href="/contact" variant="primary">Ask for a proposal</Button>
            <Button href="/programmes" variant="secondary">See the programmes</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="border-y border-line">
    <div class="max-w-7xl mx-auto px-6 md:px-8 py-10">
      <p class="text-sm text-mute mb-6">Some of the organisations we've worked with</p>
      <ul class="grid grid-cols-4 lg:grid-cols-8 gap-x-6 gap-y-8 items-center">
        {
          clients.map((client) => (
            <li class="flex items-center justify-center h-14 md:h-16">
              <Image
                src={client.logo}
                alt={client.name}
                height={128}
                class="max-h-full w-auto object-contain"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services overview -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <h2 class="font-serif font-medium text-3xl md:text-4xl text-ink tracking-tight mb-6 max-w-2xl">
        Two things we do
      </h2>
      <p class="text-base md:text-lg text-char leading-relaxed max-w-2xl mb-14">
        Most clients come to us for training. Some also want help with the systems around their
        people: HR processes, policies, how work gets planned and checked.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-line">
        {
          services.map((service, i) => (
            <article class:list={[i === 0 ? 'md:pr-12' : 'md:pl-12']}>
              <h3 class="font-serif font-medium text-2xl text-ink mb-3">{service.name}</h3>
              <p class="text-base text-char leading-relaxed mb-5">
                {service.tagline} {service.body}
              </p>
              <ul class="text-sm text-char space-y-2 mb-6 list-disc pl-5 marker:text-leaf">
                {service.items.map((item) => <li>{item}</li>)}
              </ul>
              <a
                href="/services"
                class="text-sm font-medium text-moss hover:text-moss-dark underline underline-offset-4 decoration-leaf focus-visible:outline-2 focus-visible:outline-moss focus-visible:outline-offset-2 rounded-sm"
              >
                More about {service.name.toLowerCase()}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Programmes preview -->
  <section class="py-20 md:py-28 bg-paper">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="font-serif font-medium text-3xl md:text-4xl text-ink tracking-tight mb-6">
            Ready-made programmes
          </h2>
          <p class="text-base text-char leading-relaxed mb-8">
            These nine are ready to run. We adjust the examples, exercises and depth for your
            industry and for the people in the room, so a session for bank managers won't look
            like one for site supervisors.
          </p>
          <Button href="/programmes" variant="secondary">Topics and audiences</Button>
        </div>

        <ul class="lg:col-span-8 divide-y divide-line border-y border-line">
          {
            programmes.map((programme) => (
              <li class="py-4 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
                <span class="font-medium text-ink">{programme.name}</span>
                <span class="text-sm text-mute sm:text-right shrink-0">{programme.audience}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Trainers -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <Image
          src={workPhotos[0].image}
          alt={workPhotos[0].alt}
          width={768}
          class="w-full aspect-[3/2] object-cover object-[65%_center] rounded-sm"
          loading="lazy"
        />
        <div>
          <h2 class="font-serif font-medium text-3xl md:text-4xl text-ink tracking-tight mb-6">
            Who runs the sessions
          </h2>
          <p class="text-base md:text-lg text-char leading-relaxed mb-5">
            Each programme is led by a trainer who specialises in that subject. Among them are an
            organisational development consultant, a psychology lecturer, an HR governance
            specialist, an IT trainer who teaches applied AI, and a safeguarding specialist.
          </p>
          <p class="text-base md:text-lg text-char leading-relaxed mb-8">
            Our trainers have also designed or delivered programmes for {
              trainerExperience.slice(0, -1).join(', ')
            } and {trainerExperience.at(-1)}.
          </p>
          <Button href="/team" variant="secondary">Meet the trainers</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Work in action -->
  <section class="py-20 md:py-28 bg-paper">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <h2 class="font-serif font-medium text-3xl md:text-4xl text-ink tracking-tight mb-10">
        Recent sessions
      </h2>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        {
          workPhotos.map((photo) => (
            <Image
              src={photo.image}
              alt={photo.alt}
              width={760}
              class="w-full aspect-square object-cover rounded-sm"
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </section>

  <ClosingCTA />
</Layout>
